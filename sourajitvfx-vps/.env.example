# Required: create a bot with @BotFather and paste its token here.
BOT_TOKEN=

# Telegram numeric user ID with owner privileges. Set to 0 to disable owner panel.
OWNER_ID=0

# Optional comma-separated numeric Telegram user IDs. Empty means allow all users.
ALLOWED_USERS=

# Optional channel username (without @) or numeric chat ID. Bot must be a channel admin.
FORCE_CHANNEL=
# Required for private channels; public channels can use https://t.me/<channel>.
FORCE_CHANNEL_URL=

# Non-owner VPS quota.
MAX_VPS_PER_USER=1

# Keep enabled for PRoot compatibility.
PROOT_NO_SECCOMP=1

# Optional persistent data path; blank stores data beside the source files.
DATA_DIR=

# Optional Python log level.
LOG_LEVEL=INFO
